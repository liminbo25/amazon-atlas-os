AI_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514
SELLERSPRITE_SECRET_KEY=
SELLERSPRITE_REQUEST_TIMEOUT_MS=15000
SELLERSPRITE_MAX_CONCURRENCY=4
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_SELLER_ID=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.4
# If you set OPENAI_TRANSCRIBE_BASE_URL separately, also set OPENAI_TRANSCRIBE_API_KEY.
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_TRANSCRIBE_BASE_URL=https://api.openai.com
OPENAI_TRANSCRIBE_MODEL=whisper-1

GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://ai.yijiarj.cn/v1
GEMINI_IMAGE_MODEL=nano_banana_pro
FASHN_API_KEY=
FASHN_API_BASE_URL=https://api.fashn.ai
FASHN_MODEL=tryon-max
FASHN_GENERATION_MODE=quality
FASHN_RESOLUTION=2k
FASHN_OUTPUT_FORMAT=png
REPLICATE_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

COMPETITOR_MONITOR_DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require
COMPETITOR_MONITOR_CRON_SECRET=
# Optional when using Vercel Cron. Set it to the same value so Vercel's
# Authorization header matches the competitor-monitor sync route.
CRON_SECRET=
COMPETITOR_MONITOR_DEFAULT_MARKETPLACE=US

VIDEO_OUTPUT_ROOT=
VIDEO_MAX_UPLOAD_MB=80

# Optional legacy fallback for the old FastAPI video service.
# Leave unset to use the built-in Next.js /api/video-studio routes.
# NEXT_PUBLIC_VIDEO_API_BASE_URL=http://127.0.0.1:8000
